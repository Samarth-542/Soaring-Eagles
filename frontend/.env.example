# Leave empty for local development; Vite proxies /api to localhost:8080.
# Production may set this to the HTTPS origin of the Spring Boot API.
VITE_API_BASE_URL=

# Public Supabase Storage object URL; never put the service-role key in Vercel.
# Format: https://<project-ref>.supabase.co/storage/v1/object/public/public-content
VITE_PUBLIC_CONTENT_BASE_URL=
