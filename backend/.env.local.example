# Local development only. Generate a BCrypt hash with the command in README.md.
# Do not put the plaintext password here or commit the copied .env file.
APP_ADMIN_EMAIL=admin@soaringeagles.in
APP_ADMIN_PASSWORD_HASH=replace-with-generated-bcrypt-hash

# Configure Supabase Storage to enable admin image uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_PUBLIC_BUCKET=se_data

# Resend must use a verified sender address before registration confirmations can be sent.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Contact attachments are stored in a private Supabase Storage bucket.
SUPABASE_STORAGE_PRIVATE_BUCKET=se_private
