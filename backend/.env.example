# Use these names when configuring the shell environment for a non-local
# PostgreSQL database. Spring Boot does not load dotenv files automatically.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

# Set an exact, comma-separated frontend origin allowlist in deployment.
# Do not use wildcard origins with cookie-based authentication.
# APP_CORS_ALLOWED_ORIGINS=https://website.example.com
