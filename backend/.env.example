# Template for configuring a non-local PostgreSQL database in the shell
# environment. The backend's optional .env file is for local development only.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_PUBLIC_BUCKET=se_data

# Bootstrap the initial admin using a BCrypt password hash generated securely
# outside source control. The plaintext password must never be configured here.
APP_ADMIN_EMAIL=admin@soaringeagles.in
APP_ADMIN_PASSWORD_HASH=

# Paid checkout stays disabled until the Razorpay sandbox flow and public
# webhook endpoint have been verified. Never commit real provider credentials.
APP_PAYMENT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_REGISTRATION_HOLD_DURATION=PT10M

# Resend must use a verified sender address before confirmations can be sent.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Contact attachments are stored in a private Supabase Storage bucket.
SUPABASE_STORAGE_PRIVATE_BUCKET=se_private

# Set the exact deployed frontend origin (for example, your Vercel production
# URL). Add a custom domain or additional Vercel origin as comma-separated
# values. Do not use wildcards with cookie-based authentication.
# APP_CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Use "none" only for a cross-site frontend/API deployment, with HTTPS/TLS.
# APP_SESSION_COOKIE_SAME_SITE=lax
